{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuner",
  "version": "0.1.0",
  "identifier": "com.tuner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tuner",
        "width": 800,
        "height": 500,
        "maxWidth": 960,
        "maxHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
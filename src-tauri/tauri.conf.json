{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuner",
  "version": "0.4.0",
  "identifier": "com.tuner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tuner 0.3.0",
        "width": 800,
        "height": 500,
        "maxWidth": 960,
        "maxHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$APPDATA/**",
          "**/docs/test-fixtures/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tuner.local/theme.schema.json",
  "title": "TunerBundledTheme",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "appBackground": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "surface": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "surfaceAlt": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "border": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "textMuted": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "accentContrast": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "focus": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "danger": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "warning": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "success": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "scrollbarTrack": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "scrollbarThumb": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "scrollbarThumbHover": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "terminal": { "type": "object" }
  },
  "additionalProperties": true
}
